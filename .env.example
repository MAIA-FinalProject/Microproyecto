# Configuración del Entorno
ENVIRONMENT=development
LOG_LEVEL=INFO

# Google Drive Storage (DVC Remote)
# No requiere variables de entorno: la autenticacion es OAuth individual por
# usuario. Al correr `dvc pull` o `dvc push` por primera vez se abre el
# navegador para iniciar sesion con la cuenta de Google invitada a la carpeta
# compartida del equipo; las credenciales quedan cacheadas localmente (fuera
# del repo), no en este archivo.

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=preterm_infant_prediction

# Backend (FastAPI)
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Frontend (Streamlit)
STREAMLIT_SERVER_PORT=8501
